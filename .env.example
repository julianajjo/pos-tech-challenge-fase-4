# Copie este arquivo para .env e preencha com as chaves do seu recurso Azure.
# Sem as chaves, o sistema usa os modos locais de fallback.

# Azure AI Speech (Speech to Text)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth

# Azure AI Language (Text Analytics)
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=https://<seu-recurso>.cognitiveservices.azure.com/

# Webhook opcional para envio dos alertas (Microsoft Teams, Slack, etc.)
ALERT_WEBHOOK_URL=
